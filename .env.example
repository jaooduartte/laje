# Variáveis VITE_* são incorporadas ao bundle do navegador e não devem conter segredos.

# Supabase permanece como dependência transitória durante a migração do backend.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-anonima

# Opcional enquanto o frontend ainda não foi migrado integralmente para a laje-api.
VITE_API_URL=http://localhost:3000/api/v1
