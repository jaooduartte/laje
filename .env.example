# URL pública do backend dedicado. Quando definida, autenticação administrativa usa a laje-api como fluxo principal.
# Em produção: URL HTTPS do ALB/API AWS terminando em /api/v1.
VITE_API_URL=http://localhost:3000/api/v1

# Supabase permanece como dependência transitória para os domínios ainda não migrados.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-anonima
