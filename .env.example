# Seletor explícito do backend usado por este deployment do mesmo frontend.
# O projeto Vercel atual `laje` usa "supabase".
# O futuro projeto Vercel `laje-tcc` usa "aws".
VITE_BACKEND_PROVIDER=supabase

# Obrigatória apenas no modo AWS.
# URL pública da laje-api, terminando em /api/v1.
VITE_API_URL=

# Obrigatórias apenas no modo Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-anonima
